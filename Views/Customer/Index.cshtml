
@model IEnumerable<Medical_Equipment_Rental_Management_System.Models.Customer>

@{
    ViewBag.Title = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="dashboard-title">Customer Management</h2>
        <p class="dashboard-subtitle">Manage your registered customers.</p>
    </div>

    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fa fa-plus me-2"></i>Add Customer
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="dashboard-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.CustomerId</td>
                            <td class="fw-semibold">@item.CustomerName</td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td>@item.Address</td>
                            <td>
                                <a href="@Url.Action("Edit", new { id = item.CustomerId })"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-edit"></i>
                                </a>

                                <a href="@Url.Action("Delete", new { id = item.CustomerId })"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="fa fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No customers found. Add your first customer.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
