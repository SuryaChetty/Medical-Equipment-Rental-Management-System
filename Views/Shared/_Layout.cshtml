
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - MediRent</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- MediRent Custom CSS -->
    <link href="@Url.Content("~/Content/medi-rent.css")"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

</head>

<body>

    <div class="app-wrapper">

        <!-- =================================
             FIXED SIDEBAR
        ================================== -->

        <aside class="sidebar">

            <div class="brand">
                <i class="fa-solid fa-heart-pulse"></i>
                <span>MediRent</span>
            </div>

            <div class="menu-heading">
                MAIN MENU
            </div>

            <a href="@Url.Action("Index", "Home")"
               class="menu-link">

                <i class="fa-solid fa-house"></i>
                Dashboard

            </a>

            <a href="@Url.Action("Index", "Customer")"
               class="menu-link">

                <i class="fa-solid fa-users"></i>
                Customers

            </a>

            <a href="@Url.Action("Index", "Equipment")"
               class="menu-link">

                <i class="fa-solid fa-wheelchair"></i>
                Equipment

            </a>

            <a href="@Url.Action("Index", "RentalBooking")"
               class="menu-link">

                <i class="fa-solid fa-calendar-check"></i>
                Bookings

            </a>

            <a href="@Url.Action("Index", "Payment")"
               class="menu-link">

                <i class="fa-solid fa-credit-card"></i>
                Payments

            </a>

            <a href="@Url.Action("Index", "Invoice")"
               class="menu-link">

                <i class="fa-solid fa-file-invoice"></i>
                Invoices

            </a>

            <a href="@Url.Action("Index", "Payment")"
               class="menu-link">

                <i class="fa-solid fa-credit-card"></i>
                Payment Verification

            </a>

            <!-- Sidebar Bottom -->

            <div class="sidebar-bottom">

                <a href="@Url.Action("Login", "Account")"
                   class="menu-link">

                    <i class="fa-solid fa-right-to-bracket"></i>
                    Login

                </a>

            </div>

        </aside>


        <!-- =================================
             MAIN CONTENT AREA
        ================================== -->

        <main class="main-content">

            <!-- TOP HEADER -->

            <header class="topbar">

                <div>
                    <h5 class="mb-0">
                        Healthcare Equipment Rental
                    </h5>

                    <small class="text-muted">
                        Manage your services in one place
                    </small>
                </div>

                <div class="profile">

                    <i class="fa-solid fa-circle-user"></i>

                    <span>
                        Administrator
                    </span>

                </div>

            </header>


            <!-- PAGE CONTENT -->

            <section class="page-content">

                @RenderBody()

            </section>


            <!-- FOOTER -->

            <footer class="footer">

                © @DateTime.Now.Year MediRent.
                All rights reserved.

            </footer>

        </main>

    </div>


    <!-- JAVASCRIPT -->

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)

</body>
</html>
