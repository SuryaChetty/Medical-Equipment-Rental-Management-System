
@model Medical_Equipment_Rental_Management_System.Models.Equipment

@{
    ViewBag.Title = "Edit Equipment";
}

<div class="mb-4">
    <h2 class="dashboard-title">Edit Equipment</h2>
    <p class="dashboard-subtitle">
        Update medical equipment details.
    </p>
</div>

<div class="dashboard-panel">

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.EquipmentId)

        <div class="row g-3">

            <div class="col-md-6">
                @Html.LabelFor(m => m.EquipmentName,
                    new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.EquipmentName,
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.EquipmentName,
                    "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                @Html.LabelFor(m => m.Category,
                    new { @class = "form-label fw-semibold" })

                @Html.DropDownListFor(m => m.Category,
                    new SelectList(new[]
                    {
                        "Mobility",
                        "Respiratory",
                        "Hospital Furniture",
                        "Monitoring",
                        "Rehabilitation"
                    }, Model.Category),
                    "-- Select Category --",
                    new { @class = "form-select" })

                @Html.ValidationMessageFor(m => m.Category,
                    "", new { @class = "text-danger" })
            </div>

            <div class="col-12">
                @Html.LabelFor(m => m.Description,
                    new { @class = "form-label fw-semibold" })

                @Html.TextAreaFor(m => m.Description,
                    new { @class = "form-control", rows = "3" })

                @Html.ValidationMessageFor(m => m.Description,
                    "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                @Html.LabelFor(m => m.PricePerDay,
                    "Price Per Day (₹)",
                    new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.PricePerDay,
                    new
                         {
                             @class = "form-control",
                    type = "number",
                             min = "1",
                             step = "0.01"
                         })

                @Html.ValidationMessageFor(m => m.PricePerDay,
                    "", new { @class = "text-danger" })
            </div>

            <div class="col-md-6">
                @Html.LabelFor(m => m.Stock,
                    new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.Stock,
                    new { @class = "form-control", type = "number", min = "0" })

                @Html.ValidationMessageFor(m => m.Stock,
                    "", new { @class = "text-danger" })
            </div>

            <div class="col-12">
                @Html.LabelFor(m => m.ImageUrl,
                    new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.ImageUrl,
                    new { @class = "form-control" })
            </div>

        </div>

        <hr class="my-4" />

        <button type="submit" class="btn btn-primary px-4">
            <i class="fa fa-save me-2"></i>Update Equipment
        </button>

        <a href="@Url.Action("Index")"
           class="btn btn-light border ms-2">
            Cancel
        </a>
    }
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
