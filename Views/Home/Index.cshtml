
@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: #f7faff;
    }

    .hero-section {
        background: linear-gradient(115deg, #073b67, #087eaa);
        color: white;
        padding: 85px 0;
        border-radius: 0 0 35px 35px;
    }

    .hero-title {
        font-size: 45px;
        font-weight: 800;
        line-height: 1.2;
    }

    .hero-text {
        font-size: 17px;
        color: #e0f2fe;
        margin-top: 20px;
        line-height: 1.8;
    }

    .hero-image {
        width: 100%;
        max-height: 350px;
        object-fit: contain;
    }

    .section-title {
        font-size: 30px;
        font-weight: 800;
        color: #123b5d;
    }

    .section-subtitle {
        color: #718096;
        font-size: 15px;
    }

    .category-card,
    .equipment-card,
    .feature-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        height: 100%;
        box-shadow: 0 5px 22px rgba(30, 70, 110, 0.07);
        transition: 0.3s;
    }

        .category-card:hover,
        .equipment-card:hover,
        .feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(30, 70, 110, 0.13);
        }

    .category-icon {
        width: 65px;
        height: 65px;
        background: #e8f5ff;
        color: #087eaa;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin: 0 auto 15px;
    }

    .equipment-image {
        height: 175px;
        width: 100%;
        object-fit: contain;
        padding: 10px;
        background: #f5faff;
        border-radius: 12px;
    }

    .equipment-name {
        color: #173f60;
        font-size: 18px;
        font-weight: 700;
    }

    .price {
        color: #07845c;
        font-size: 20px;
        font-weight: 800;
    }

    .primary-btn {
        background: #08a0c7;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }

        .primary-btn:hover {
            background: #087eaa;
            color: white;
            text-decoration: none;
        }

    .outline-btn {
        border: 1px solid white;
        color: white;
        padding: 11px 24px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
        font-weight: 600;
    }

        .outline-btn:hover {
            background: white;
            color: #087eaa;
            text-decoration: none;
        }

    .feature-icon {
        font-size: 32px;
        color: #0796bd;
        margin-bottom: 15px;
    }

    .steps-section {
        background: #eaf6fc;
        border-radius: 25px;
        padding: 45px 25px;
    }

    .step-number {
        background: #087eaa;
        color: white;
        height: 45px;
        width: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        font-weight: bold;
        margin: 0 auto 15px;
    }

    .cta-section {
        background: linear-gradient(110deg, #073b67, #087eaa);
        padding: 45px 20px;
        border-radius: 20px;
        color: white;
    }

    @@media(max-width: 768px) {
        .hero-section {
            padding: 55px 15px;
        }

        .hero-title {
            font-size: 32px;
        }

        .hero-image {
            margin-top: 30px;
        }
    }
</style>

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-md-6">
                <span class="badge badge-light p-2 mb-3">
                    Healthcare Equipment Rental Platform
                </span>

                <h1 class="hero-title">
                    Better Healthcare Starts With the Right Equipment
                </h1>

                <p class="hero-text">
                    Rent quality medical equipment at affordable prices.
                    Get the equipment you need for home care, patient recovery,
                    and healthcare support.
                </p>

                <div class="mt-4">
                    <a href="@Url.Action("Index", "Equipment")"
                       class="primary-btn mr-2">
                        <i class="fa fa-search"></i> Explore Equipment
                    </a>

                    <a href="@Url.Action("Contact", "Home")"
                       class="outline-btn">
                        Contact Us
                    </a>
                </div>

                <div class="row mt-5">
                    <div class="col-4">
                        <h3 class="font-weight-bold">Easy</h3>
                        <small>Online Booking</small>
                    </div>
                    <div class="col-4">
                        <h3 class="font-weight-bold">Safe</h3>
                        <small>Quality Equipment</small>
                    </div>
                    <div class="col-4">
                        <h3 class="font-weight-bold">Fast</h3>
                        <small>Simple Process</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 text-center">
                <img src="https://placehold.co/600x400/e8f5ff/087eaa?text=Medical+Equipment+Rental"
                     class="hero-image"
                     alt="Medical equipment rental" />
            </div>

        </div>
    </div>
</section>

<!-- CATEGORIES -->
<section class="container py-5">

    <div class="text-center mb-5">
        <h2 class="section-title">Explore Medical Equipment</h2>
        <p class="section-subtitle">
            Find the right equipment for your healthcare needs.
        </p>
    </div>

    <div class="row">

        <div class="col-md-3 col-6 mb-4">
            <div class="category-card text-center">
                <div class="category-icon">
                    <i class="fa fa-bed"></i>
                </div>
                <h5 class="font-weight-bold">Hospital Beds</h5>
                <p class="text-muted small">
                    Comfortable beds for patient care.
                </p>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-4">
            <div class="category-card text-center">
                <div class="category-icon">
                    <i class="fa fa-wheelchair"></i>
                </div>
                <h5 class="font-weight-bold">Wheelchairs</h5>
                <p class="text-muted small">
                    Mobility support equipment.
                </p>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-4">
            <div class="category-card text-center">
                <div class="category-icon">
                    <i class="fa fa-heartbeat"></i>
                </div>
                <h5 class="font-weight-bold">Monitoring</h5>
                <p class="text-muted small">
                    Essential patient monitoring devices.
                </p>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-4">
            <div class="category-card text-center">
                <div class="category-icon">
                    <i class="fa fa-medkit"></i>
                </div>
                <h5 class="font-weight-bold">Oxygen Support</h5>
                <p class="text-muted small">
                    Respiratory care equipment.
                </p>
            </div>
        </div>

    </div>
</section>

<!-- FEATURED EQUIPMENT -->
<section class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="section-title">Our Medical Equipment</h2>
            <p class="section-subtitle">
                Browse equipment available for rental.
            </p>
        </div>

        <a href="@Url.Action("Index", "Equipment")"
           class="font-weight-bold">
            View All <i class="fa fa-arrow-right"></i>
        </a>
    </div>

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="equipment-card">
                <img src="https://placehold.co/500x300/f2f8fc/087eaa?text=Hospital+Bed"
                     class="equipment-image"
                     alt="Hospital bed" />

                <div class="mt-3">
                    <h5 class="equipment-name">Hospital Bed</h5>
                    <p class="text-muted">
                        Adjustable bed for comfortable patient care.
                    </p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="price">Affordable Rental</span>
                        <a href="@Url.Action("Index", "Equipment")"
                           class="btn btn-sm btn-outline-primary">
                            View
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="equipment-card">
                <img src="https://placehold.co/500x300/f2f8fc/087eaa?text=Wheelchair"
                     class="equipment-image"
                     alt="Wheelchair" />

                <div class="mt-3">
                    <h5 class="equipment-name">Wheelchair</h5>
                    <p class="text-muted">
                        Mobility assistance for everyday movement.
                    </p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="price">Affordable Rental</span>
                        <a href="@Url.Action("Index", "Equipment")"
                           class="btn btn-sm btn-outline-primary">
                            View
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="equipment-card">
                <img src="https://placehold.co/500x300/f2f8fc/087eaa?text=Oxygen+Concentrator"
                     class="equipment-image"
                     alt="Oxygen concentrator" />

                <div class="mt-3">
                    <h5 class="equipment-name">Oxygen Concentrator</h5>
                    <p class="text-muted">
                        Respiratory support equipment for home care.
                    </p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="price">Affordable Rental</span>
                        <a href="@Url.Action("Index", "Equipment")"
                           class="btn btn-sm btn-outline-primary">
                            View
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- HOW IT WORKS -->
<section class="container py-5">

    <div class="steps-section">

        <div class="text-center mb-5">
            <h2 class="section-title">How MediRent Works</h2>
            <p class="section-subtitle">
                Get your required medical equipment in three simple steps.
            </p>
        </div>

        <div class="row text-center">

            <div class="col-md-4 mb-4">
                <div class="step-number">1</div>
                <h5 class="font-weight-bold">Choose Equipment</h5>
                <p class="text-muted">
                    Browse available medical equipment and select what you need.
                </p>
            </div>

            <div class="col-md-4 mb-4">
                <div class="step-number">2</div>
                <h5 class="font-weight-bold">Book Equipment</h5>
                <p class="text-muted">
                    Select your rental dates and submit your booking request.
                </p>
            </div>

            <div class="col-md-4 mb-4">
                <div class="step-number">3</div>
                <h5 class="font-weight-bold">Complete Payment</h5>
                <p class="text-muted">
                    Make payment using the available UPI payment process.
                </p>
            </div>

        </div>
    </div>
</section>

<!-- WHY CHOOSE US -->
<section class="container py-5">

    <div class="text-center mb-5">
        <h2 class="section-title">Why Choose MediRent?</h2>
        <p class="section-subtitle">
            Simple and convenient medical equipment rental services.
        </p>
    </div>

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="feature-card text-center">
                <div class="feature-icon">
                    <i class="fa fa-check-circle"></i>
                </div>
                <h5 class="font-weight-bold">Quality Equipment</h5>
                <p class="text-muted">
                    Access carefully maintained medical equipment for your needs.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="feature-card text-center">
                <div class="feature-icon">
                    <i class="fa fa-rupee"></i>
                </div>
                <h5 class="font-weight-bold">Affordable Rentals</h5>
                <p class="text-muted">
                    Choose rental periods that suit your requirements and budget.
                </p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="feature-card text-center">
                <div class="feature-icon">
                    <i class="fa fa-headphones"></i>
                </div>
                <h5 class="font-weight-bold">Customer Support</h5>
                <p class="text-muted">
                    Get assistance throughout your equipment rental process.
                </p>
            </div>
        </div>

    </div>
</section>

<!-- CALL TO ACTION -->
<section class="container py-4 mb-5">

    <div class="cta-section text-center">
        <h2 class="font-weight-bold">
            Need Medical Equipment?
        </h2>

        <p class="mt-3 mb-4">
            Explore our equipment collection and book what you need today.
        </p>

        <a href="@Url.Action("Index", "Equipment")"
           class="btn btn-light btn-lg font-weight-bold text-primary">
            Explore Equipment <i class="fa fa-arrow-right"></i>
        </a>
    </div>

</section>
```